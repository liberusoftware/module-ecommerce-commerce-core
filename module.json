{
    "$schema": "https://schemas.liberu.dev/module/v1.json",
    "name": "ecommerce-commerce-core",
    "display_name": "Commerce Core",
    "description": "Stores, channels, commercial context, order numbering, shared states, settings, capabilities and domain events.",
    "version": "0.4.0",
    "category": "capability",
    "provider": "Liberu\\Ecommerce\\CommerceCore\\CommerceCoreServiceProvider",
    "requires": {
        "php": "^8.5",
        "laravel": "^13.0",
        "packages": {
            "liberusoftware/module-manager": "^1.4"
        }
    },
    "capabilities": [
        "ecommerce.commerce-core"
    ],
    "default_enabled": false,
    "features": [
        "Stores",
        "Channels",
        "Channel domains",
        "Channel resolution",
        "Commercial context",
        "Order numbering",
        "Shared states",
        "Settings",
        "Capabilities",
        "Domain events",
        "Read models",
        "Store and channel queries",
        "Telemetry"
    ]
}
