{
    "name": "liberusoftware/ecommerce-commerce-core",
    "description": "Stores, channels and the commercial context every other Ecommerce module resolves against.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.4.0",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "liberusoftware/module-manager": "^1.4"
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.6",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\CommerceCore\\": "src/",
            "Liberu\\Ecommerce\\CommerceCore\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\CommerceCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "liberu": {
            "name": "ecommerce-commerce-core"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
